# seriell-sanierung.de — Apache/LiteSpeed-Konfiguration (Hostinger)

DirectoryIndex index.php index.html
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) HTTPS erzwingen
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Kanonische Domain ohne www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 3) /kontakt  ->  /kontakt.php  (schöne URLs, optional)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
  RewriteRule ^(.+?)/?$ /$1.php [L]
</IfModule>

# Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>

# Caching statischer Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

# Versteckte Dateien schützen
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>
<FilesMatch "\.(md|yml|yaml)$">
  Require all denied
</FilesMatch>
